{
  "$comment": [
    "MediKiosk governed clinical content — ayush_ayurveda v1 (CLAUDE.md §12).",
    "",
    "This protocol EXTENDS general_medicine v1. It is not a second system: the",
    "same engine binary executes both, and the inherited gm.* fields (SOCRATES,",
    "ROS, PMH/PSH, drug/allergy, family history, and the AMPLE fast path) are the",
    "identical, once-authored, once-translated content. Only C and F are extended,",
    "exactly as §12 specifies.",
    "",
    "CLINICAL SCOPE NOTE — Dashavidha Pariksha is classically a PRACTITIONER",
    "examination. What a kiosk can honestly collect is the patient-reportable",
    "component: history, self-described constitution indicators, Ahara-Vihara and",
    "Nidana. Each such fact is written as a dashavidha_parameter with",
    "source_type=patient_answer and reaches the practitioner as an UNVERIFIED",
    "intake indicator to be confirmed or corrected at examination — never as a",
    "determined Prakriti. Determination remains the practitioner's act (§21).",
    "",
    "Adding Siddha/Unani/Homeopathy later is a further protocol data file and an",
    "i18n bundle — zero engine change (§12).",
    "",
    "LANGUAGE-NEUTRAL BY CONTRACT: no patient-facing text in this file."
  ],
  "protocol_family": "ayush_ayurveda",
  "version": "v1",
  "extends": {
    "family": "general_medicine",
    "version": "v1"
  },
  "governance": {
    "authored_by": "AYUSH Clinical Governance reviewers",
    "review_state": "prototype_pending_board_ratification",
    "framework": "Dashavidha Pariksha + Ahara-Vihara + Nidana + Samprapti, layered on the general history"
  },
