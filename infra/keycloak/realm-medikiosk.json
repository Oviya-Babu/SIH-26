{
  "realm": "medikiosk",
  "enabled": true,
  "displayName": "MediKiosk",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 0,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined)",
  "roles": {
    "realm": [
      {
        "name": "nurse",
        "description": "Nurse / Triage. Red-flag queue for their own department only. No physician or admin actions (§5.2)."
      },
      {
        "name": "physician",
        "description": "Physician. Edit/reject/approve assigned sessions. MFA required. No post-export writes (§5.2)."
      },
      {
        "name": "ayush_practitioner",
        "description": "AYUSH practitioner. Physician authority plus NAMASTE/ICD-11 TM2 confirmation (§12, §24). MFA required."
      },
      {
        "name": "clinical_admin",
        "description": "Clinical Governance. Protocol and red-flag review queue. NO clinical record access; changes route through the CI gate (§5.2). MFA required."
      },
      {
        "name": "it_admin",
        "description": "IT Admin. Own-tenant device/user/integration config. NO clinical data. MFA required (§5.2)."
      },
      {
        "name": "security_officer",
        "description": "Security & Privacy Officer. Audit export (step-up MFA), consent and retention status. NO clinical editing (§5.2)."
      },
      {
        "name": "caregiver_respondent",
        "description": "Reserved. Caregivers are NOT Keycloak identities in this design — they hold an ephemeral kiosk token (§4). Present so the role name is never reused for something else."
      }
    ]
  },
  "clients": [
    {
      "clientId": "medikiosk-staff",
      "name": "MediKiosk Staff Workspace",
      "description": "The Nurse/Physician/Admin frontend. Public client using authorization code + PKCE — a browser app must never hold a client secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3200/*",
        "http://127.0.0.1:3200/*"
      ],
      "webOrigins": [
        "http://localhost:3200",
        "http://127.0.0.1:3200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3200/*",
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-staff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "medikiosk-staff",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "medikiosk-browser-mfa",
      "description": "Browser flow requiring OTP for privileged roles (§27)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "medikiosk-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "medikiosk-forms",
      "description": "Username/password followed by a mandatory OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true,
          "autheticatorFlow": false
        }
      ]
    }
  ],
