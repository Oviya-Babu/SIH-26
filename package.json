{
  "name": "medikiosk",
  "version": "1.0.0",
  "private": true,
  "description": "MediKiosk — AI-Powered Pre-Consultation Clinical Intake Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit --workspaces",
    "clean": "rimraf apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  }
}
